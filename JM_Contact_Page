<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact — Joshua Martinez</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
<link rel="stylesheet" href="subpage.css">
</head>
<body class="page-contact">

  <!-- SECONDARY NAV -->
  <header class="sub-nav">
    <a href="index.html" class="sub-nav-logo">
      <img src="JM_Portfolio_%20Assets/JM%20Logo.svg" alt="JM">
    </a>
  </header>

  <!-- CONTACT FORM -->
  <main class="contact-main">
    <h1 class="contact-heading">Want to get in touch?<br>Drop me a line!</h1>

    <form class="contact-form" action="https://formspree.io/f/xjyblwee" method="POST">
      <div class="contact-row">
        <div class="contact-field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" placeholder="Enter your name" required>
        </div>
        <div class="contact-field">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" placeholder="Enter your email" required>
        </div>
      </div>
      <div class="contact-field contact-field-full">
        <label for="message">Message</label>
        <textarea id="message" name="message" placeholder="Enter your message" required></textarea>
      </div>
      <button type="submit" class="contact-submit">Submit</button>
    </form>
  </main>

  <!-- FOOTER -->
  <footer class="footer" style="background-image: url('Home_Footer_Portfolio_Assets/Footer_%20Image.png');">
    <div class="footer-inner">
      <div class="footer-left">
        <p class="footer-tagline">Let's make something memorable.</p>
        <p class="footer-subtext">Available for select design collaborations.</p>
      </div>
      <div class="footer-right">
        <ul class="footer-links">
          <li><a href="https://www.behance.net/JoshuaMR95" target="_blank" rel="noopener"><img src="Home_Footer_Portfolio_Assets/behance.png" alt="" class="footer-icon">Behance — JoshuaMR95</a></li>
          <li><a href="https://www.linkedin.com/in/joshua-martinez" target="_blank" rel="noopener"><img src="Home_Footer_Portfolio_Assets/linkedin.png" alt="" class="footer-icon">LinkedIn — Joshua Martinez</a></li>
          <li><a href="mailto:joshuadavid0119@gmail.com"><img src="Home_Footer_Portfolio_Assets/gmail.png" alt="" class="footer-icon">joshuadavid0119@gmail.com</a></li>
        </ul>
        <p class="footer-copyright">© 2026 Joshua Martinez</p>
      </div>
    </div>
  </footer>

  <script src="script.js"></script>
</body>
</html>
